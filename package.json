{
  "name": "league-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:oxlint\" \"lint:eslint\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:ci": "oxlint . --deny-warnings && eslint . --max-warnings=0",
    "format": "oxfmt src/ e2e/",
    "format:check": "oxfmt --check src/ e2e/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check": "run-s format:check lint:ci type-check test build-only"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.6",
    "@vueuse/core": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "description": "Sports league explorer for the Sporty Group frontend take-home (Vue 3 + TheSportsDB)."
}
